+        out.push_back({question_id(q),TopicKind::Thought,std::uint8_t(q.kind==QuestionKind::Contact?5:7),q.kind==QuestionKind::Contact?q.target:0,priority,.3,q.changed,state_.now+31000,q.revision,q.basis,false});}
