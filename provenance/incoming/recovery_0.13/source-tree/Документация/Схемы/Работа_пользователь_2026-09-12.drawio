        <mxCell id="GJSKL5g9J1f-4CGufi4q-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Чем выше должность тем выше социальный и финансовые статусы.&lt;br&gt;В рамках деревни повышаются меньше в рамках работы выше, условно начальник в приказном порядке в рамках работы заставлять НПС делать действия направленные на работу" vertex="1">
          <mxGeometry height="250" width="120" x="680" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="GJSKL5g9J1f-4CGufi4q-34" edge="1" parent="1" source="GJSKL5g9J1f-4CGufi4q-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="GJSKL5g9J1f-4CGufi4q-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="GJSKL5g9J1f-4CGufi4q-18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="НПС может работать(повышая свою карьерную ступень) - может отлынивать понижая - но начальник заствляет работать повышая и хвалит тех кто работает хорошо" vertex="1">
          <mxGeometry height="195" width="120" x="410" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="GJSKL5g9J1f-4CGufi4q-35" edge="1" parent="1" source="GJSKL5g9J1f-4CGufi4q-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="GJSKL5g9J1f-4CGufi4q-16">
