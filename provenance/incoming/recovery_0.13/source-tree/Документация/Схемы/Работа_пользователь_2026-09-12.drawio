        <mxCell id="GJSKL5g9J1f-4CGufi4q-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Разделение на начальника, заместителя, Специалиста&lt;br&gt;Рабочего" vertex="1">
