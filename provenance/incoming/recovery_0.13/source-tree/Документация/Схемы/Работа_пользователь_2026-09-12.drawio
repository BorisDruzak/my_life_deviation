        </mxCell>
        <mxCell id="GJSKL5g9J1f-4CGufi4q-20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Действия на работе определяются условно симулированно(на текущем этапе разработки, просто либо работать, либо заниматься чем-то другим на работе)" vertex="1">
          <mxGeometry height="190" width="120" x="910" y="1445" as="geometry" />
        </mxCell>
        <mxCell id="GJSKL5g9J1f-4CGufi4q-27" edge="1" parent="1" source="GJSKL5g9J1f-4CGufi4q-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="GJSKL5g9J1f-4CGufi4q-28">
