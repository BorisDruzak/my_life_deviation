        <mxCell id="aPfJ42vkN6LIO1LG62Q2-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Рассмотрение цепочки является субъективным ОПЫТОМ нпс" vertex="1">
          <mxGeometry height="110" width="175" x="2947.5" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="aPfJ42vkN6LIO1LG62Q2-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Рассматривается не конкретная цепочка действий а КОНТЕКСТ/РЕЗУЛЬТАТ&lt;br&gt;&lt;br&gt;Условно&lt;br&gt;Цепочка из - потребность в близости/общении - действие, сходить в клуб(опыт нпс из прошлого) + действие разговор(результат)/результат повышение уровня потребностей." vertex="1">
          <mxGeometry height="197.5" width="220" x="3210" y="1100" as="geometry" />
        </mxCell>
