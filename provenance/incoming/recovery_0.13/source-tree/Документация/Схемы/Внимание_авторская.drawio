            <mxPoint x="460" y="2470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="aPfJ42vkN6LIO1LG62Q2-15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Мысль - возникающая из контекста ситуации(включая внутреннию ситуацию с потребностями), передача данных пропускаемых через память в НПС, процесс передаёт НПС данные о состоянии потребности или группы потребностей/характеристик" vertex="1">
          <mxGeometry height="160" width="300" x="310" y="2580" as="geometry" />
        </mxCell>
        <mxCell id="aPfJ42vkN6LIO1LG62Q2-19" edge="1" parent="1" source="aPfJ42vkN6LIO1LG62Q2-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="aPfJ42vkN6LIO1LG62Q2-20">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="1830" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="aPfJ42vkN6LIO1LG62Q2-17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Процесс формирования мысли - пропускает переданную информацию через восприятия" vertex="1">
          <mxGeometry height="120" width="320" x="300" y="2380" as="geometry" />
        </mxCell>
        <mxCell id="aPfJ42vkN6LIO1LG62Q2-20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Механизм восприятие данных. Очередь Отвлечение.&lt;br&gt;&lt;br&gt;Условно НПС А - Взаимодействует с НПС Б, в процессе - это однопоточный механизм в рамках которого НПС не передаются другие мысли из-за постонной необходимости взаимодействия и просчитывания на объекте ФОКУСА(то есть НПС взаимодействую с другим объектом выстраивает цепочку только для этого объекта -паралельность просчётов, учитывается лишь при высоком показатели интелекта но чем бльше фокус(заинтересовонность стимул исходя из субъективного восприятия количественного повышения потребностей) тем менше НПС выстраивает очередь мыслей), при этом очередь не является статичной, условное попадание в очередь, не запускает процесс - для этого фактически нужен расчёт, если НПС не может посчитать(условно посчитать имеется ввиду механизм Внимания для просчёта дайствий цепочки построения действий, для простого действия Общаться(по причине уточнения дороги, может просчитаться быстро, поэтому пока персонаж условно Идёт до обекта/события точки запуска другого действия, общение может быть инициированно и не прервёт процесс Идёт, просто остановит выполнение)), после чего механизм внимания снова может начать считать процесс изначальный.&lt;br&gt;Очередь динамически выстраивается из объектов взаимодействия субъективно просчитаных по результату - при том резульатт просчитывается и с учётом Интересов. При этом условный механизм Отвлечения - строится на более высоком стимуле - учитывая что стимул высоким может быть и у другого НПС, факт инициации так-же сместит фокус на Выолнении.&lt;br&gt;Таким образом Динамическая очередь состоит из объекта фокуса, объекта отвлечения, объекты отвлечения могут статус объектом фокуса или исчезнуть из очереди в следствии отсуствия достаточно выского стимула - из-за появления другого или исчезании самого стимула(если НПС ушёл из места где был стимул в следтсвии более выского фокуса на другом объекте или НПС который был в объекте отвлечения ушёл) -&amp;nbsp;" vertex="1">
          <mxGeometry height="520" width="380" x="740" y="1740" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
