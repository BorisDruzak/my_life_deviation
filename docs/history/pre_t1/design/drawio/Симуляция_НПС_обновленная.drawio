          <mxGeometry height="140" width="490" x="12520" y="1670" as="geometry"/>
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-197" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Желания и особые побуждения&lt;/font&gt;&lt;span style=&quot;font-size: 25px; text-align: left;&quot;&gt;&lt;/span&gt;" vertex="1">
