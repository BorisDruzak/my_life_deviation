        <mxCell id="2mPlI_ey6MAs90VP1WGT-188" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=25;" value="&lt;span style=&quot;text-align: left;&quot;&gt;Тип&lt;/span&gt;&lt;br style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Интенсивность&lt;/span&gt;&lt;br style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Триггеры&lt;/span&gt;&lt;br style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Какие потребности удовлетворяет&lt;/span&gt;&lt;br style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Какие действия усиливает&lt;/span&gt;&lt;br style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Какой барьер девиации требуется&lt;/span&gt;&lt;br style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Насколько насыщается&lt;/span&gt;&lt;br style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Насколько усиливается при потакании&lt;/span&gt;&lt;br style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Какие знания необходимы&lt;/span&gt;" vertex="1">
          <mxGeometry height="750" width="310" x="-640" y="1190" as="geometry"/>
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-191" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=25;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Порог девиации.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="750" width="310" x="180" y="1190" as="geometry"/>
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-193" edge="1" parent="1" source="2mPlI_ey6MAs90VP1WGT-192" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
