            <Array as="points">
              <mxPoint x="-2620" y="205" />
              <mxPoint x="-2620" y="205" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-44" edge="1" parent="1" source="2mPlI_ey6MAs90VP1WGT-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="2mPlI_ey6MAs90VP1WGT-45">
