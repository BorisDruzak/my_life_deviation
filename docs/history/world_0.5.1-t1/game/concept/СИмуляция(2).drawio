        <mxCell id="2mPlI_ey6MAs90VP1WGT-199" edge="1" parent="1" source="2mPlI_ey6MAs90VP1WGT-192" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="2mPlI_ey6MAs90VP1WGT-196">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-200" edge="1" parent="1" source="2mPlI_ey6MAs90VP1WGT-192" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="2mPlI_ey6MAs90VP1WGT-197">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-192" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;br style=&quot;font-size: 25px; text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 25px; text-align: left;&quot;&gt;Целипологание НПС&lt;br&gt;&lt;br&gt;Выставляет рамки задач в которых НПС Симулируется - то есть механизм позволяющий НПС делать что-то не только ради удволитворение потребностей. Действия имеют свойста - которые показывают какой ПОТЕНЦИАЛЬНЫЙ для целей может быть от Действия, но НПС во 1 может неправильно или неточно предсказывать его, а во вторых выстраивать цепочки событий чтобы избеждать ущерба&lt;/span&gt;" vertex="1">
          <mxGeometry height="690" width="490" x="12580" y="440" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-194" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;br style=&quot;font-size: 25px; text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 25px; text-align: left;&quot;&gt;Потребности.&lt;br&gt;&lt;br&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="490" x="13750" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-195" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;br style=&quot;text-align: left;&quot;&gt;Защищаемые ценности&lt;/font&gt;&lt;span style=&quot;font-size: 25px; text-align: left;&quot;&gt;&lt;br&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="490" x="13150" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-196" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;Обязательства&lt;/font&gt;&lt;span style=&quot;font-size: 25px; text-align: left;&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="490" x="12520" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-197" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Желания и особые побуждения&lt;/font&gt;&lt;span style=&quot;font-size: 25px; text-align: left;&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="490" x="11850" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-202" edge="1" parent="1" source="2mPlI_ey6MAs90VP1WGT-201" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="2mPlI_ey6MAs90VP1WGT-132">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-201" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;Коофицент перенасыщения - показывает насколько конкретная психологическая потребность перенасыщенна повторяющимся конкретным действием.&lt;br&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="350" width="310" x="-3530" y="-950" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-204" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;Сила удволитворённости разнообразием - высчитывается после совершения действия основываясь на НПС.&lt;br&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="350" width="310" x="-3130" y="-955" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-206" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Характеристики - или базовые настройки поведения&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="310" x="895" y="-2810" as="geometry" />
        </mxCell>
        <mxCell id="2mPlI_ey6MAs90VP1WGT-216" edge="1" parent="1" source="2mPlI_ey6MAs90VP1WGT-207" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="2mPlI_ey6MAs90VP1WGT-206">
